{
  "name": "jarvis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JARVIS — shaxsiy AI operatsion tizim",
  "scripts": {
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "backup": "tsx server/cli.ts backup",
    "restore": "tsx server/cli.ts restore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@vitejs/plugin-react": "^6.3.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7"
  }
}
