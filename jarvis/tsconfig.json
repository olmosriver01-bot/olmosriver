{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noImplicitAny": false, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"], "resolveJsonModule": true
  },
  "include": ["server", "shared", "web/src", "tests"]
}
