# JARVIS созламалари. Бу файлни .env номи билан нусхаланг. Калитларни ҳеч қачон репозиторийга қўшманг.

# Сервер манзили. 127.0.0.1 — фақат шу компьютер. iPhone'дан уланиш учун 0.0.0.0 (фақат ишончли тармоқ/VPN орқали!).
HOST=127.0.0.1
PORT=3333

# Маълумотлар папкаси (база, файллар, backup). Бўш бўлса: jarvis/data
JARVIS_DATA_DIR=

# Биринчи кириш пароли (ихтиёрий; бўлмаса биринчи очилишда интерфейсда ўрнатасиз). Камида 8 белги.
JARVIS_PASSWORD=

# API калитларини шифрлаш учун махфий сўз (ихтиёрий). Бўлмаса data/secret.key автоматик яратилади.
# ДИҚҚАТ: уни йўқотсангиз, сақланган API калитларини қайта киритишингиз керак бўлади.
JARVIS_SECRET=

# AI провайдер калитлари (ихтиёрий — интерфейсда Созламалар → AI провайдерлар орқали ҳам киритиш мумкин).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Тест учун сохта провайдер (ҳақиқий фойдаланишда ЁҚМАНГ). Жавоблари "MOCK" деб белгиланади.
JARVIS_ENABLE_MOCK=
